{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sastra Compressor",
  "mainBinaryName": "SastraCompressor",
  "version": "2.1.0",
  "identifier": "com.krysion.sastra.compressor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Sastra™ Compressor",
        "width": 1040,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Krysion",
    "copyright": "© 2026 Ken “Krysion” Nisaka",
    "category": "Utility",
    "shortDescription": "Compresses images, audio, and video for the Sastra™ visual novel engine",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/ffmpeg"],
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "installer/header.bmp",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["English"]
      }
    }
  }
}
